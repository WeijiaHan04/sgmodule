#!name=YouTube Music Enhance（仅 Music）
#!desc=只作用于 YouTube Music（按 User-Agent 区分，遇到 YouTube 主 App 的请求直接放行）。不改写 next 接口和 get_watch 里的队列部分，修复切歌后随机/循环被重置
#!arguments=屏蔽选段按钮:true,屏蔽上传按钮:true,翻译语言:off,启用调试模式:false
#!arguments-desc=- 选段按钮即 Samples 标签\n- 屏蔽参数：[true, false]\n- 翻译语言：[语言代码, off]，语言代码遵循 Google Translate，off 为关闭\n- 调试模式用于输出更多日志

[Script]
ytm.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|player|search|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-music_response.js,argument="{"captionLang":"{{{翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":false,"debug":{{{启用调试模式}}}}"
ytm.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-music_request.js,argument="{"captionLang":"{{{翻译语言}}}"}"
ytm.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-music_request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
