#!name=YouTube Enhance（仅 YouTube）
#!desc=只作用于 YouTube 主 App（按 User-Agent 区分，遇到 YouTube Music 的请求直接放行）。完整去广告，包括 next 接口
#!arguments=屏蔽上传按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false]\n- 字幕翻译：[语言代码, off]，语言代码遵循 Google Translate，off 为关闭\n- 调试模式用于输出更多日志

[Script]
yt.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-video.response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":false,"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"
yt.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-video.request.js,argument="{"captionLang":"{{{字幕翻译语言}}}"}"
yt.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-video.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
