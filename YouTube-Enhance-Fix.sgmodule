#!name=YouTube & Music Enhance 修复版
#!desc=同时作用于 YouTube 和 YouTube Music。脚本内部按 User-Agent 区分：YouTube 与原版完全一致；Music 不改写 next 和 get_watch 的队列部分，修复切歌后随机/循环被重置
#!arguments=Music跳过next:true,Music跳过get_watch队列:true,屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=- Music跳过next / Music跳过get_watch队列：true 为不处理（修循环重置），false 为和原版一样处理\n- 屏蔽参数：[true, false]\n- 选段按钮即 Music 的 Samples 标签\n- 翻译参数：[语言代码, off]，语言代码遵循 Google Translate，off 为关闭\n- 调试模式用于输出更多日志

[Rule]
# 拒绝 YouTube 的 QUIC(UDP 443)，让 App 直接走 TCP，免得先试 UDP 失败再回退，也保证 MITM 能生效
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT-NO-DROP

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/WeijiaHan04/sgmodule/main/yt-enhance-response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}},"musicSkipNext":{{{Music跳过next}}},"musicSkipWatchNext":{{{Music跳过get_watch队列}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{字幕翻译语言}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
